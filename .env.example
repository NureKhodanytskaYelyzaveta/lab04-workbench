# Скопіюйте у .env і вставте свій ключ (ніколи не комітьте .env)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"          # якщо 503/504 — спробуйте іншу модель зі списку доступних

# База знань (ЛР 2): сховище Obsidian і готовий індекс Chroma
OBSIDIAN_VAULT="/mnt/c/Users/<користувач>/Documents/kb-vault/kb-vault"
OBSIDIAN_VAULT_NAME="kb-vault"           # назва сховища в Obsidian (для посилань obsidian://)
CHROMA_PATH="/home/<користувач>/ai-agents/lab02-knowledge/kb-agent/chroma_data"
KB_COLLECTION="obsidian_kb"
EMBED_MODEL="gemini-embedding-001"
EMBED_DIM="768"
KB_TOP_K="4"
KB_MAX_DISTANCE="0.33"                   # значення з калібрування ЛР 2

# Журнал запусків
WORKBENCH_DB="workbench.db"
